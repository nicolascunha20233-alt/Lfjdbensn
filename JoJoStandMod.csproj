<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>JoJoStandMod</AssemblyName>
    <RootNamespace>JoJoStandMod</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.5.0</Version>
    <AssemblyVersion>1.5.0.0</AssemblyVersion>
    <FileVersion>1.5.0.0</FileVersion>
    <Product>JoJo Stands</Product>
    <AssemblyTitle>JoJo Stands</AssemblyTitle>
    <Description>Stands de JoJo para o Hollow Knight</Description>
    <DebugType>none</DebugType>
